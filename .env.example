# Project directory. Default is %USERPROFILE%\Documents\FXJEFE_Project
# (Path.home() / "Documents" / "FXJEFE_Project"). FXJEFE_PROJECT_DIR wins over
# the legacy FXJEFE_PROJECT_ROOT alias. --project-dir wins over both.
FXJEFE_PROJECT_DIR=
FXJEFE_PROJECT_ROOT=
FXJEFE_FEATURE_POLICY=ACCEPT_ALL_FEATURES
FXJEFE_FEATURE_REGISTRY_VERSION=v1_april2025
FXJEFE_DEMO_MODE=0
FXJEFE_MIN_CONFIDENCE=0.77
FXJEFE_ALLOW_ALL_FEATURES=1
FXJEFE_STRIP_FEATURES=0
FXJEFE_REFUSE_FEATURES=0
FXJEFE_AUTO_ENABLED=1
FXJEFE_AI_SERVER_URL=http://127.0.0.1:8080
FXJEFE_BRIDGE_URL=http://127.0.0.1:8000
FXJEFE_ZMQ_PORT=5555
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
# Optional equity snapshot for the FTMO gate when the terminal is not connected.
# Percents are evaluated only from an FTMO config file; these are not limits.
FXJEFE_ACCOUNT_BALANCE=
FXJEFE_ACCOUNT_EQUITY=
FXJEFE_DAY_START_EQUITY=
FXJEFE_INITIAL_BALANCE=
FXJEFE_DATA_PATH=
FXJEFE_MODELS_PATH=
FXJEFE_LOG_PATH=
